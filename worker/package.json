{
  "name": "homebknet-status",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that serves /status.json for the homebknet.us homepage. No runtime dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "mutate": "node test/mutations.mjs",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
